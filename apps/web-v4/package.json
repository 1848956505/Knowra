{
  "name": "@study-accelerator/web-v4",
  "version": "2.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @study-accelerator/web-core",
    "dev": "vite",
    "prebuild": "npm run build -w @study-accelerator/web-core",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build -w @study-accelerator/web-core",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node ../../scripts/check-v4-boundaries.mjs",
    "pretest": "npm run build -w @study-accelerator/web-core",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run check:boundaries && npm run test"
  },
  "dependencies": {
    "@milkdown/kit": "^7.21.2",
    "@study-accelerator/web-core": "2.14.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
