{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowra.local/ai-conversation-v2.schema.json",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "time": { "type": "string", "format": "date-time" },
    "nullableTime": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
    "nullableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "nullableCode": { "oneOf": [{ "type": "string", "pattern": "^AI_[A-Z0-9_]{1,64}$" }, { "type": "null" }] },
    "boundary": {
      "type": "object", "properties": {
        "contractVersion": { "const": 2 }, "ownerId": { "$ref": "#/$defs/id" },
        "datasetId": { "$ref": "#/$defs/id" }, "datasetEpoch": { "$ref": "#/$defs/id" },
        "spaceId": { "$ref": "#/$defs/id" }
      }, "required": ["contractVersion", "ownerId", "datasetId", "datasetEpoch", "spaceId"]
    },
    "source": {
      "type": "object", "properties": {
        "noteId": { "$ref": "#/$defs/id" }, "noteVersionId": { "$ref": "#/$defs/id" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 },
        "quoteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }, "required": ["noteId", "noteVersionId", "contentHash", "start", "end", "quoteHash"],
      "additionalProperties": false
    },
    "aiConversation": {
      "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/boundary" }, {
        "type": "object", "properties": {
          "kind": { "const": "aiConversation" }, "conversationId": { "$ref": "#/$defs/id" },
          "actorId": { "$ref": "#/$defs/id" }, "createdAt": { "$ref": "#/$defs/time" },
          "updatedAt": { "$ref": "#/$defs/time" }, "archivedAt": { "$ref": "#/$defs/nullableTime" }
        }, "required": ["kind", "conversationId", "actorId", "createdAt", "updatedAt", "archivedAt"]
      }]
    },
    "aiConversationTurn": {
      "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/boundary" }, {
        "type": "object", "properties": {
          "executionStartedAt": { "$ref": "#/$defs/time" }, "checkpoint": { "$ref": "#/$defs/checkpoint" }, "kind": { "const": "aiConversationTurn" }, "turnId": { "$ref": "#/$defs/id" },
          "conversationId": { "$ref": "#/$defs/id" }, "jobId": { "$ref": "#/$defs/id" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "idempotencyKey": { "type": "string", "pattern": "^[a-zA-Z0-9-]{8,80}$" },
          "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "userMessageId": { "$ref": "#/$defs/id" }, "assistantMessageId": { "$ref": "#/$defs/nullableId" },
          "requestedPolicyId": { "$ref": "#/$defs/nullableId" },
          "writeIntent": { "type": "object", "additionalProperties": false, "required": ["toolName"],
            "properties": { "toolName": { "enum": ["notes_create", "notes_append", "notes_propose_patch", "notes_propose_organize"] }, "noteId": { "$ref": "#/$defs/id" } } },
          "status": { "enum": ["staged", "running", "interrupted", "succeeded", "failed", "cancelled"] },
          "phase": { "enum": ["waiting", "retrieving", "generating", "validating", "finished"] },
          "leaseGeneration": { "type": "integer", "minimum": 0 },
          "leaseExpiresAt": { "$ref": "#/$defs/nullableTime" },
          "errorCode": { "$ref": "#/$defs/nullableCode" },
          "createdAt": { "$ref": "#/$defs/time" }, "updatedAt": { "$ref": "#/$defs/time" }
        }, "required": ["kind", "turnId", "conversationId", "jobId", "ordinal", "idempotencyKey", "inputHash", "userMessageId", "assistantMessageId", "requestedPolicyId", "status", "phase", "leaseGeneration", "leaseExpiresAt", "errorCode", "createdAt", "updatedAt"]
      }]
    },
    "aiConversationMessage": {
      "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/boundary" }, {
        "type": "object", "properties": {
          "kind": { "const": "aiConversationMessage" }, "messageId": { "$ref": "#/$defs/id" },
          "conversationId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" },
          "sequence": { "type": "integer", "minimum": 1 }, "role": { "enum": ["user", "assistant"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 120000 },
          "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/source" }, "maxItems": 128 },
          "citations": { "type": "array", "items": { "$ref": "#/$defs/source" }, "maxItems": 128 },
          "provenanceManifestId": { "$ref": "#/$defs/nullableId" },
          "sourceFree": { "type": "boolean" },
          "finishReason": { "oneOf": [{ "enum": ["stop", "tool_calls"] }, { "type": "null" }] },
          "createdAt": { "$ref": "#/$defs/time" }
        }, "required": ["kind", "messageId", "conversationId", "turnId", "sequence", "role", "content", "sourceRefs", "provenanceManifestId", "sourceFree", "finishReason", "createdAt"]
      }]
    },
    "aiConversationToolCall": {
      "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/boundary" }, {
        "type": "object", "properties": {
          "kind": { "const": "aiConversationToolCall" }, "callId": { "$ref": "#/$defs/id" },
          "conversationId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "toolName": { "enum": ["notes_search", "notes_read", "notes_create", "notes_append", "notes_propose_patch", "notes_propose_organize", "web_search"] },
          "argumentsJson": { "type": "object" }, "resultJson": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
          "provenanceManifestId": { "$ref": "#/$defs/nullableId" },
          "status": { "enum": ["requested", "succeeded", "failed"] },
          "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/source" }, "maxItems": 128 },
          "errorCode": { "$ref": "#/$defs/nullableCode" },
          "createdAt": { "$ref": "#/$defs/time" }, "updatedAt": { "$ref": "#/$defs/time" }
        }, "required": ["kind", "callId", "conversationId", "turnId", "ordinal", "toolName", "argumentsJson", "resultJson", "provenanceManifestId", "status", "sourceRefs", "errorCode", "createdAt", "updatedAt"]
      }]
    },
    "aiConversationModelAttempt": {
      "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/boundary" }, {
        "type": "object", "properties": {
          "responseRejectedCode": { "$ref": "#/$defs/nullableCode" }, "responseRejectedAt": { "$ref": "#/$defs/time" }, "modelResult": { "type": "object" }, "kind": { "const": "aiConversationModelAttempt" },
          "attemptId": { "$ref": "#/$defs/id" }, "conversationId": { "$ref": "#/$defs/id" },
          "turnId": { "$ref": "#/$defs/id" }, "ordinal": { "type": "integer", "minimum": 1 },
          "leaseGeneration": { "type": "integer", "minimum": 1 },
          "modelId": { "$ref": "#/$defs/id" }, "recipient": { "enum": ["deepseek"] },
          "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "manifestId": { "$ref": "#/$defs/nullableId" }, "grantId": { "$ref": "#/$defs/nullableId" },
          "reservedMicrounits": { "type": "integer", "minimum": 1, "maximum": 2000000 },
          "actualMicrounits": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
          "status": { "enum": ["prepared", "reserved", "sent", "settled", "unknown", "released"] },
          "errorCode": { "$ref": "#/$defs/nullableCode" },
          "createdAt": { "$ref": "#/$defs/time" }, "updatedAt": { "$ref": "#/$defs/time" }
        }, "required": ["kind", "attemptId", "conversationId", "turnId", "ordinal", "leaseGeneration", "modelId", "recipient", "payloadHash", "manifestId", "grantId", "reservedMicrounits", "actualMicrounits", "status", "errorCode", "createdAt", "updatedAt"]
      }]
    },
    "checkpoint": {"type": "object", "additionalProperties": false, "properties": {"version": {"const": 1}, "nextRound": {"type": "integer", "minimum": 0, "maximum": 4}, "totalTools": {"type": "integer", "minimum": 0, "maximum": 6}, "handledAttemptOrdinal": {"type": "integer", "minimum": 0, "maximum": 8}, "noProgressRounds": {"type": "integer", "minimum": 0, "maximum": 4}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/source"}, "maxItems": 128}, "initialSearchDone": {"type": "boolean"}, "searchTruncated": {"type": "boolean"}, "searchFallback": {"type": "boolean"}, "forceAnswer": {"type": "boolean"}, "externalContext": {"type": "string", "maxLength": 3000}, "toolFeedback": {"type": "string", "maxLength": 3000}}, "required": ["version", "nextRound", "totalTools", "handledAttemptOrdinal", "noProgressRounds", "sourceRefs", "initialSearchDone", "searchTruncated", "searchFallback", "forceAnswer", "externalContext", "toolFeedback"]},
    "aiConversationAttachment": {
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/boundary"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "aiConversationAttachment"
            },
            "attachmentId": {
              "type": "string",
              "format": "uuid"
            },
            "conversationId": {
              "$ref": "#/$defs/id"
            },
            "uploadKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-]{8,80}$"
            },
            "fileName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180,
              "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$"
            },
            "mimeType": {
              "enum": [
                "application/pdf",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "text/plain",
                "text/markdown",
                "image/png",
                "image/jpeg"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5242880
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "storageStatus": {
              "enum": [
                "pending",
                "ready",
                "missing",
                "removed"
              ]
            },
            "parseStatus": {
              "enum": [
                "pending",
                "ready",
                "failed",
                "vision_unsupported"
              ]
            },
            "parserVersion": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "parsedTextHash": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "segments": {
              "type": "array",
              "maxItems": 4000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200000
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                },
                "required": [
                  "text",
                  "start",
                  "end"
                ]
              }
            },
            "imageMetadata": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20000
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20000
                    },
                    "format": {
                      "enum": [
                        "png",
                        "jpeg"
                      ]
                    }
                  },
                  "required": [
                    "width",
                    "height",
                    "format"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "errorCode": {
              "$ref": "#/$defs/nullableCode"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "removedAt": {
              "$ref": "#/$defs/nullableTime"
            },
            "cleanupStatus": {
              "enum": [
                "none",
                "pending",
                "complete"
              ]
            },
            "createdAt": {
              "$ref": "#/$defs/time"
            },
            "updatedAt": {
              "$ref": "#/$defs/time"
            }
          },
          "required": [
            "kind",
            "attachmentId",
            "conversationId",
            "uploadKey",
            "fileName",
            "mimeType",
            "size",
            "sha256",
            "storageStatus",
            "parseStatus",
            "parserVersion",
            "parsedTextHash",
            "segments",
            "imageMetadata",
            "errorCode",
            "revision",
            "removedAt",
            "cleanupStatus",
            "createdAt",
            "updatedAt"
          ]
        }
      ]
    }
  }
}
