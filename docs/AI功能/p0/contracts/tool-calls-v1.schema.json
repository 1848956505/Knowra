{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowra.local/schemas/ai-tool-calls-v1",
  "title": "Knowra model-proposed tool calls v1",
  "description": "Only a proposal shape. Server attaches actor, grant, request, operation ID and current baseline; the model cannot supply them.",
  "oneOf": [
    { "$ref": "#/$defs/notesSearch" },
    { "$ref": "#/$defs/notesRead" },
    { "$ref": "#/$defs/foldersList" },
    { "$ref": "#/$defs/tagsList" },
    { "$ref": "#/$defs/notesCreate" },
    { "$ref": "#/$defs/notesAppend" },
    { "$ref": "#/$defs/notesProposePatch" },
    { "$ref": "#/$defs/notesProposeOrganize" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "notesSearch": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": {
        "contractVersion": { "const": 1 }, "tool": { "const": "notes_search" },
        "arguments": {
          "type": "object", "additionalProperties": false, "required": ["query", "limit"],
          "properties": {
            "query": { "type": "string", "minLength": 1, "maxLength": 300 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        }
      }
    },
    "notesRead": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": {
        "contractVersion": { "const": 1 }, "tool": { "const": "notes_read" },
        "arguments": {
          "type": "object", "additionalProperties": false, "required": ["noteIds"],
          "properties": {
            "noteIds": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        }
      }
    },
    "foldersList": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": { "contractVersion": { "const": 1 }, "tool": { "const": "folders_list" }, "arguments": { "type": "object", "additionalProperties": false } }
    },
    "tagsList": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": { "contractVersion": { "const": 1 }, "tool": { "const": "tags_list" }, "arguments": { "type": "object", "additionalProperties": false } }
    },
    "notesCreate": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": {
        "contractVersion": { "const": 1 }, "tool": { "const": "notes_create" },
        "arguments": {
          "type": "object", "additionalProperties": false,
          "required": ["title", "markdown", "folderId", "tagIds"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "markdown": { "type": "string", "maxLength": 120000 },
            "folderId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "tagIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        }
      }
    },
    "notesAppend": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": {
        "contractVersion": { "const": 1 }, "tool": { "const": "notes_append" },
        "arguments": {
          "type": "object", "additionalProperties": false,
          "required": ["noteId", "markdown", "anchor"],
          "properties": {
            "noteId": { "$ref": "#/$defs/id" },
            "markdown": { "type": "string", "minLength": 1, "maxLength": 30000 },
            "anchor": { "type": "object", "additionalProperties": false,
              "required": ["kind", "headingId"],
              "properties": { "kind": { "enum": ["end", "afterHeading"] }, "headingId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] } }
            }
          }
        }
      }
    },
    "notesProposePatch": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": {
        "contractVersion": { "const": 1 }, "tool": { "const": "notes_propose_patch" },
        "arguments": {
          "type": "object", "additionalProperties": false,
          "required": ["noteId", "start", "end", "expectedText", "newText"],
          "properties": {
            "noteId": { "$ref": "#/$defs/id" },
            "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 },
            "expectedText": { "type": "string", "minLength": 1, "maxLength": 30000 },
            "newText": { "type": "string", "maxLength": 30000 }
          }
        }
      }
    },
    "notesProposeOrganize": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "tool", "arguments"],
      "properties": {
        "contractVersion": { "const": 1 }, "tool": { "const": "notes_propose_organize" },
        "arguments": {
          "type": "object", "additionalProperties": false, "required": ["changes"],
          "properties": {
            "changes": { "type": "array", "minItems": 1, "maxItems": 20,
              "items": { "type": "object", "additionalProperties": false,
                "required": ["noteId", "title", "folderOperation", "folderId", "tagsOperation", "tagIds"],
                "properties": {
                  "noteId": { "$ref": "#/$defs/id" },
                  "title": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "null" }] },
                  "folderOperation": { "enum": ["keep", "root", "move"] },
                  "folderId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
                  "tagsOperation": { "enum": ["keep", "replace"] },
                  "tagIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
