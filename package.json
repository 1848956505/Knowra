    "test:desktop": "npm test -w @study-accelerator/desktop-runtime",
    "start:desktop": "npm run start -w @study-accelerator/desktop-runtime --",
    "test:web": "npm test -w @study-accelerator/web-v4",
    "test:web:legacy": "npm test -w @study-accelerator/web",
    "test:web-core": "npm test -w @study-accelerator/web-core",
    "test:web:v4": "npm test -w @study-accelerator/web-v4",
    "test:scripts": "node --test scripts/test/*.test.js",
    "dev:web": "npm run dev -w @study-accelerator/web-v4",
    "dev:web:v4": "npm run dev -w @study-accelerator/web-v4",
    "dev:api": "npm run dev -w @study-accelerator/api",
    "start:api": "npm run dev -w @study-accelerator/api",
    "dev:all": "node scripts/start-dev.mjs",
    "build:web": "npm run build -w @study-accelerator/web-v4",
    "build:web:v4": "npm run build:web",
    "start:web": "npm run start -w @study-accelerator/web-v4",
    "build:web-core": "npm run build -w @study-accelerator/web-core",
    "check:web:v4": "npm run check -w @study-accelerator/web-v4",
    "lint": "node scripts/lint/run.mjs eslint .",
    "lint:fix": "node scripts/lint/run.mjs eslint . --fix",
    "format:check": "node scripts/lint/run.mjs prettier . --check",
    "format": "node scripts/lint/run.mjs prettier . --write",
    "audit:prod": "npm audit --omit=dev --omit=optional --audit-level=high",
    "prisma:validate": "npx prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:postgres": "node scripts/migrate-json-to-postgres.mjs",
    "check:attachments": "node scripts/check-attachments.mjs",
    "measure:assets": "node scripts/measure-asset-storage.mjs",
    "build:mac": "node scripts/build-info.mjs --require-clean && npm run build:web && npm run build -w @study-accelerator/desktop-shell",
    "test:mac": "node apps/desktop-shell/scripts/verify-distribution.mjs --test",
    "install:mac": "node apps/desktop-shell/scripts/install-and-cleanup.mjs",
    "verify:mac": "node apps/desktop-shell/scripts/verify-distribution.mjs",
    "test:shared": "npm test -w @study-accelerator/shared"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.3.0",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "nanoid": "5.1.16"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
